+def camera_ray_world_directions(pixels, camera_intrinsics, camera_to_world_R):
+    ray_cam = torch.stack([(pixels[..., 0] - camera_intrinsics[..., 0, 2]) / camera_intrinsics[..., 0, 0],
+                           (pixels[..., 1] - camera_intrinsics[..., 1, 2]) / camera_intrinsics[..., 1, 1],
+                           torch.ones_like(pixels[..., 0])], dim=-1)
+    ray_cam = ray_cam / torch.linalg.norm(ray_cam, dim=-1, keepdim=True)
+    return torch.matmul(camera_to_world_R, ray_cam[..., None]).squeeze(-1)

